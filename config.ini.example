[tequila]
api_key = YOUR_TEQUILA_API_KEY_HERE

[amadeus]
# Amadeus API - alternative to Tequila
# Get your credentials at https://developers.amadeus.com/
client_id = YOUR_AMADEUS_CLIENT_ID
client_secret = YOUR_AMADEUS_CLIENT_SECRET

[search]
# Comma-separated origin IATA codes or major hubs. Default includes common European hubs.
origins = FRA, LHR, MUC, CDG, AMS, MAD, BCN, ZRH, BER
currency = EUR
max_price = 1800
min_duration_hours = 8
date_from = 2026-02-01
date_to = 2026-08-31
limit = 20
# Optional: cabin class (Y=Economy, W=PremiumEco, C=Business, F=First)
cabin_class = C
# Maximum stopovers per direction (integer, e.g. 0 = nonstop, 1 = one stop)
max_stopovers = 2
# Backend: 'tequila', 'amadeus', or 'localfile' to read sample results from disk
backend = amadeus
# If using localfile backend, set the path to a JSON file containing an array of matches
localfile_path = data/sample_matches.json

[notifications]
# Telegram bot (optional)
telegram_bot_token = 
telegram_chat_id = 

[storage]
# Storage backend: 'json' (default, files on disk) or 'mongodb'
backend = json
# MongoDB settings (only used when backend = mongodb)
# mongo_host = localhost
# mongo_port = 27017
# mongo_db = flightscanner
# mongo_username =
# mongo_password =
# mongo_auth_source = admin

[smtp]
# SMTP settings (optional)
# host = smtp.example.com
# port = 587
# username = your_smtp_user
# password = your_smtp_password
# sender = flights@example.com
# recipient = you@example.com
